{
  "configVersion": "penang-2026-08-12-feedscope-fix",
  "server": {
    "apiProcessingTimeout": "6s"
  },
  "timetableUpdates": {
    "maxSnapshotFrequency": "2s",
    "purgeExpiredData": true
  },
  "routingDefaults": {
    "numItineraries": 6,
    "transferPenalty": 180,
    "waitReluctance": 1.0,
    "walk": {
      "speed": 1.3,
      "reluctance": 4.5,
      "stairsReluctance": 8.0,
      "boardCost": 600
    },
    "accessEgress": {
      "maxDuration": "25m",
      "maxStopCount": 300
    },
    "itineraryFilters": {
      "nonTransitGeneralizedCostLimit": "500 + 1.5x"
    }
  },
  "transit": {
    "maxNumberOfTransfers": 6,
    "maxSearchWindow": "PT90M",
    "dynamicSearchWindow": {
      "minTransitTimeCoefficient": 0.5,
      "minWaitTimeCoefficient": 0.5,
      "minWindow": "35m",
      "maxWindow": "90m",
      "stepMinutes": 10
    }
  },
  "updaters": [
    {
      "type": "vehicle-positions",
      "feedId": "1",
      "url": "https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-penang",
      "frequency": "30s"
    }
  ]
}