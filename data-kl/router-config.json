{
  "configVersion": "kl-2026-08-13-latency-tuning-v3",
  "server": {
    "apiProcessingTimeout": "8s"
  },
  "timetableUpdates": {
    "maxSnapshotFrequency": "2s",
    "purgeExpiredData": true
  },
  "routingDefaults": {
    "numItineraries": 6,
    "transferPenalty": 120,
    "waitReluctance": 1.0,
    "walk": {
      "speed": 1.3,
      "reluctance": 4.0,
      "stairsReluctance": 8.0,
      "boardCost": 600
    },
    "accessEgress": {
      "maxDuration": "20m",
      "maxStopCount": 200
    },
    "itineraryFilters": {
      "nonTransitGeneralizedCostLimit": "600 + 1.5x"
    }
  },
  "transit": {
    "maxNumberOfTransfers": 6,
    "maxSearchWindow": "PT75M",
    "dynamicSearchWindow": {
      "minTransitTimeCoefficient": 0.5,
      "minWaitTimeCoefficient": 0.5,
      "minWindow": "30m",
      "maxWindow": "75m",
      "stepMinutes": 10
    }
  },
  "updaters": [
    {
      "type": "vehicle-positions",
      "feedId": "3",
      "url": "https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-kl",
      "frequency": "30s"
    },
    {
      "type": "vehicle-positions",
      "feedId": "2",
      "url": "https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-mrtfeeder",
      "frequency": "30s"
    },
    {
      "type": "vehicle-positions",
      "feedId": "1",
      "url": "https://api.data.gov.my/gtfs-realtime/vehicle-position/ktmb",
      "frequency": "30s"
    }
  ]
}
